# Only needed when running docker compose yourself (Coolify generates the passwords).
SERVICE_PASSWORD_MONGO=change-me-mongo
SERVICE_PASSWORD_ADMIN=change-me-admin
PUBLIC_HOST=exposr.example.com
SERVICE_PORT_RANGE=20000-20099
# Not used outside Coolify, but must be defined to silence the warning.
SERVICE_FQDN_EXPOSR_8080=
